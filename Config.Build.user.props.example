<Project>

  <!--
    复制本文件为同目录下的 Config.Build.user.props（去掉 .example 后缀），
    再按本机实际情况修改下面两个路径。该用户文件已被 .gitignore 排除。

    提示：
      · Steam 默认安装位置通常是
          C:\Program Files (x86)\Steam\steamapps\common\PEAK
      · 若你用的是从 Thunderstore 下载的 BepInEx 整合包（解压到任意目录），
        BepInExCore 应指向其中 ...\BepInExPack_PEAK\BepInEx\core。
  -->
  <PropertyGroup>
    <!-- PEAK 游戏安装目录（内含 PEAK_Data\Managed\Assembly-CSharp.dll） -->
    <PeakRoot>C:\Program Files (x86)\Steam\steamapps\common\PEAK</PeakRoot>

    <!-- BepInEx 的 core 目录（内含 BepInEx.dll / 0Harmony.dll） -->
    <BepInExCore>C:\Program Files (x86)\Steam\steamapps\common\PEAK\BepInEx\core</BepInExCore>
  </PropertyGroup>

</Project>
